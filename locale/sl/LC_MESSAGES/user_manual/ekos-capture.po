"    <CameraDataClassVersion>1</CameraDataClassVersion>\n"
"    <CameraId>ZWO CCD ASI071MC Pro</CameraId>\n"
"    <SensorType>COLOR</SensorType>\n"
"    <GainSelectionType>NORMAL</GainSelectionType>\n"
