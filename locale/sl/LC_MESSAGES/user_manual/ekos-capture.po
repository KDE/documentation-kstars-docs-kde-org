"        <CameraGainReadNoise>\n"
"            <GainReadNoiseValue>\n"
"                <Gain>0</Gain>\n"
"                <ReadNoise>3.28</ReadNoise>\n"
"            </GainReadNoiseValue>\n"
"            <GainReadNoiseValue>\n"
"                <Gain>50</Gain>\n"
