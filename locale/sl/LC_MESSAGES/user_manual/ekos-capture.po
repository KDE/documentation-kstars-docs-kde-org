"        <GainSelection>0</GainSelection>\n"
"        <GainSelection>250</GainSelection>\n"
"    </CameraGainSelections>\n"
"    <CameraGainReadMode>\n"
"        <GainReadModeNumber>0</GainReadModeNumber>\n"
